# =============================================================================
# velonote — .env Example
#
# WHAT GOES HERE:
#   - Host/connection details (DB, Redis, server bind)
#   - Sensitive credentials (SMTP password, AI API keys, Firebase keys)
#   - Admin bootstrap email
#
# WHAT DOES NOT GO HERE:
#   - Non-sensitive runtime defaults → config/app.config.json  (auto-created)
#   - Generated secrets            → secrets.env               (auto-created)
#
# HOW TO USE:
#   cp .env.example .env
#   # Fill in your values, then start the app — secrets.env and
#   # config/app.config.json will be created automatically on first run.
# =============================================================================

# ============================================================
# Database Connection (host/user — password auto-generated into secrets.env,
# but also needed here for docker-compose variable substitution)
# ============================================================
DB_USER=velonote
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
DB_NAME=velonote

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Server
# ============================================================
# HOST / API_PORT: what uvicorn (the FastAPI process) binds to inside the container.
HOST=0.0.0.0
API_PORT=8000

# PUBLIC_PORT: the host port that nginx (or docker-compose) exposes to the outside world.
PUBLIC_PORT=8000

# ============================================================
# Admin Bootstrap Account
# ============================================================
# If set, this account is elevated to Admin on startup if it already exists.
ADMIN_EMAIL=admin@example.com

# ============================================================
# SMTP Email Configuration
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SENDER_NAME=velonote
SMTP_TLS=True

# ============================================================
# Local Ollama & Deployment Modes (Option B)
# ============================================================
# Docker Compose Mode Selection:
# - 'builtin'   : Runs Ollama inside the same Docker stack and auto-downloads the model on first boot.
# - 'standalone': Connects to an external Ollama instance (separate container or host process).
COMPOSE_PROFILES=builtin

# Target model to auto-download and use (1.5B fits strictly in ~1.2 GB RAM):
OLLAMA_MODEL=qwen2.5:1.5b

# ============================================================
# Global AI Configuration (Task-Specific 3-Tier Fallback)
# ============================================================
# Tier 1 (Instant Model): Used for chat, explaining, and interaction where instant answer is crucial.
GLOBAL_AI_TIER1_PROVIDER=groq
GLOBAL_AI_TIER1_MODEL=llama-3.1-8b-instant
GLOBAL_AI_TIER1_API_KEY=
GLOBAL_AI_TIER1_REASONING_LEVEL=low
GLOBAL_AI_TIER1_BASE_URL=

# Tier 2 (Processing/Formatting Model): Used for document processing and exercise generation.
# Set to 'ollama' with 'qwen2.5:1.5b' to enable Option B local AI formatting!
# - For builtin Docker stack : http://ollama:11434
# - For standalone host/server: http://host.docker.internal:11434 (or http://localhost:11434 locally)
GLOBAL_AI_TIER2_PROVIDER=ollama
GLOBAL_AI_TIER2_MODEL=qwen2.5:1.5b
GLOBAL_AI_TIER2_API_KEY=
GLOBAL_AI_TIER2_REASONING_LEVEL=low
GLOBAL_AI_TIER2_BASE_URL=http://ollama:11434

# Tier 3 (Backup Model): Used as the final fallback if Tier 2 fails.
GLOBAL_AI_TIER3_PROVIDER=gemini
GLOBAL_AI_TIER3_MODEL=models/gemma-4-26b-a4b-it
GLOBAL_AI_TIER3_API_KEY=
GLOBAL_AI_TIER3_REASONING_LEVEL=high
GLOBAL_AI_TIER3_BASE_URL=

# ============================================================
# Firebase Configuration
# Get values from Firebase Console → Project Settings → Your Apps
# ============================================================
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
