# =============================================================================
# velonote — .env Example
#
# WHAT GOES HERE:
#   - Host/connection details (DB, Redis, server bind)
#   - Sensitive credentials (SMTP password, AI API keys, Firebase keys)
#   - Admin bootstrap email
#
# WHAT DOES NOT GO HERE:
#   - Non-sensitive runtime defaults → config/app.config.json  (auto-created)
#   - Generated secrets            → secrets.env               (auto-created)
#
# HOW TO USE:
#   cp .env.example .env
#   # Fill in your values, then start the app — secrets.env and
#   # config/app.config.json will be created automatically on first run.
# =============================================================================

# ============================================================
# Database Connection (host/user — password auto-generated into secrets.env,
# but also needed here for docker-compose variable substitution)
# ============================================================
DB_USER=velonote
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
DB_NAME=velonote


# ============================================================
# Server & Ports
# ============================================================
# HOST / API_PORT: what uvicorn (FastAPI) binds to.
# In development: API is accessible directly at http://localhost:8000
HOST=0.0.0.0
API_PORT=8000

# FRONTEND_PORT: port for Vite development server (in development).
# In development: Vite frontend is accessible at http://localhost:5173
FRONTEND_PORT=5173

# PUBLIC_PORT: external host port exposed by Nginx in production (full Docker stack).
# Nginx serves static assets and reverse-proxies /api to the FastAPI backend.
# Recommended: 3000 (or 80 / 8080 depending on your server setup)
PUBLIC_PORT=3000

# ============================================================
# Admin Bootstrap Account
# ============================================================
# If set, this account is elevated to Admin on startup if it already exists.
ADMIN_EMAIL=admin@example.com

# ============================================================
# SMTP Email Configuration
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SENDER_NAME=velonote
SMTP_TLS=True

# ============================================================
# Local Ollama & Deployment Modes (Option B)
# ============================================================
# Docker Compose Mode Selection:
# - 'builtin'   : Runs Ollama inside the same Docker stack and auto-downloads the model on first boot.
# - 'standalone': Connects to an external Ollama instance (separate container or host process).
COMPOSE_PROFILES=builtin

# Target model to auto-download and use (1.5B fits strictly in ~1.2 GB RAM):
OLLAMA_MODEL=qwen2.5:1.5b

# ============================================================
# AI Configuration — Category 1: Chat / Instant Response
# ============================================================
# Used for conversational chat, query rewrite, voice, and instant grading.
# Prioritizes low latency and fast first-token response time.
AI_CHAT_TIER1_PROVIDER=groq
AI_CHAT_TIER1_MODEL=llama-3.1-8b-instant
AI_CHAT_TIER1_API_KEY=
AI_CHAT_TIER1_REASONING_LEVEL=low
AI_CHAT_TIER1_BASE_URL=

AI_CHAT_TIER2_PROVIDER=gemini
AI_CHAT_TIER2_MODEL=gemini-2.5-flash
AI_CHAT_TIER2_API_KEY=
AI_CHAT_TIER2_REASONING_LEVEL=
AI_CHAT_TIER2_BASE_URL=

AI_CHAT_TIER3_PROVIDER=
AI_CHAT_TIER3_MODEL=
AI_CHAT_TIER3_API_KEY=
AI_CHAT_TIER3_REASONING_LEVEL=
AI_CHAT_TIER3_BASE_URL=

# ============================================================
# AI Configuration — Category 2: Document Processing & Heavy Tasks
# ============================================================
# Used for document extraction AI polish, notes generation, and exercises.
# Prioritizes formatting accuracy, instruction adherence, and larger context windows.
#
# Tier 1 (Local Ollama):
# - For builtin Docker stack : http://ollama:11434
# - For standalone host/server: http://host.docker.internal:11434 (or http://localhost:11434 locally)
AI_PROCESSING_TIER1_PROVIDER=ollama
AI_PROCESSING_TIER1_MODEL=qwen2.5:1.5b
AI_PROCESSING_TIER1_API_KEY=
AI_PROCESSING_TIER1_REASONING_LEVEL=low
AI_PROCESSING_TIER1_BASE_URL=http://ollama:11434

# Tier 2 (Groq Fallback):
AI_PROCESSING_TIER2_PROVIDER=groq
AI_PROCESSING_TIER2_MODEL=llama-3.3-70b-versatile
AI_PROCESSING_TIER2_API_KEY=
AI_PROCESSING_TIER2_REASONING_LEVEL=low
AI_PROCESSING_TIER2_BASE_URL=

# Tier 3 (Gemini Fallback):
AI_PROCESSING_TIER3_PROVIDER=gemini
AI_PROCESSING_TIER3_MODEL=models/gemma-4-26b-a4b-it
AI_PROCESSING_TIER3_API_KEY=
AI_PROCESSING_TIER3_REASONING_LEVEL=high
AI_PROCESSING_TIER3_BASE_URL=

# ============================================================
# Firebase Configuration
# Get values from Firebase Console → Project Settings → Your Apps
# ============================================================
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
