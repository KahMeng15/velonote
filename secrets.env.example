# =============================================================================
# velonote — secrets.env
#
# THIS FILE IS AUTO-GENERATED ON FIRST STARTUP.
# Do NOT commit this file to version control — it is gitignored.
#
# On every startup, the app checks for missing values below and generates them.
# You can also populate these manually if you prefer (e.g. for Docker secrets
# or when migrating from an existing installation).
#
# To regenerate a value: delete its line and restart the app.
# =============================================================================

# JWT signing key — generate manually with: openssl rand -hex 32
SECRET_KEY=

# Fernet encryption key for secrets stored in the DB
# Generate manually with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# PostgreSQL password — also used by Docker Compose for the db container
DB_PASSWORD=
